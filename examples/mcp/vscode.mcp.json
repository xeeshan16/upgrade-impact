{
  "inputs": [
    {
      "type": "promptString",
      "id": "github-token",
      "description": "GitHub token that can read public repositories and your PRs (gh auth token)",
      "password": true
    }
  ],
  "servers": {
    "upgrade-impact": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/xeeshan16/upgrade-impact", "upgrade-impact", "mcp"],
      "env": {
        "GITHUB_TOKEN": "${input:github-token}"
      }
    }
  }
}
