{
  "mcpServers": {
    "upgrade-impact": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/xeeshan16/upgrade-impact", "upgrade-impact", "mcp"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "OLLAMA_HOST": "${OLLAMA_HOST:-http://localhost:11434}"
      }
    }
  }
}
